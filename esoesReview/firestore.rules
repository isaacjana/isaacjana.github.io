rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private data: PennyWise, Life and personal eSOEs notes.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // eSOEs shared workspaces. The document ID is the 8-character share code.
    match /esoes_workspaces/{code} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function isOwner() { return signedIn() && resource.data.owner == request.auth.uid; }
      function onlyMembersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      }
      function onlyMyEntryChanged() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      }

      // Reading a workspace needs its code (no listing, so codes can't be enumerated).
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isOwner()
        // join with the code while joining is open
        || (signedIn() && resource.data.joinOpen == true && !(request.auth.uid in resource.data.members)
            && onlyMembersChanged() && onlyMyEntryChanged() && request.auth.uid in request.resource.data.members)
        // leave
        || (isMember() && !isOwner() && onlyMembersChanged() && onlyMyEntryChanged()
            && !(request.auth.uid in request.resource.data.members));
      allow delete: if isOwner();

      // Sessions, feedback and settings: members only. (Two segments so this never
      // matches the workspace document itself, whose rules are above.)
      match /{subcollection}/{rest=**} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/esoes_workspaces/$(code)).data.members;
      }
    }
  }
}
